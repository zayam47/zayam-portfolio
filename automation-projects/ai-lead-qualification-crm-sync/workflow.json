{
  "name": "AI Lead Qualification & CRM Auto-Sync",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-intake",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "70586887-7768-48e9-91cd-4198e045f415",
      "name": "New Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-40, 300]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "leadName", "type": "string", "value": "={{ $json.body.name }}" },
            { "id": "a2", "name": "leadEmail", "type": "string", "value": "={{ $json.body.email }}" },
            { "id": "a3", "name": "leadPhone", "type": "string", "value": "={{ $json.body.phone }}" },
            { "id": "a4", "name": "leadMessage", "type": "string", "value": "={{ $json.body.message }}" },
            { "id": "a5", "name": "leadSource", "type": "string", "value": "={{ $json.body.source || 'website-form' }}" }
          ]
        },
        "options": {}
      },
      "id": "6dac39b4-73ae-489b-aba2-2aef0ae7621f",
      "name": "Normalize Lead Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [180, 300]
    },
    {
      "parameters": {
        "resource": "chat",
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a sales qualification assistant. Given a lead's inquiry, return ONLY a JSON object with keys: score (\"hot\", \"warm\", or \"cold\"), reasoning (1 sentence), and draft_reply (a short, personalized first-touch reply, max 3 sentences)."
            },
            {
              "role": "user",
              "content": "=Lead name: {{ $json.leadName }}\nSource: {{ $json.leadSource }}\nMessage: {{ $json.leadMessage }}"
            }
          ]
        },
        "options": { "temperature": 0.3 }
      },
      "id": "aa28fda6-36c2-4fac-ab0b-1ea42f5e5382",
      "name": "AI Lead Scoring & Reply Draft",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.3,
      "position": [400, 300],
      "credentials": {
        "openAiApi": { "id": "OPENAI_CREDENTIAL_ID", "name": "OpenAI account" }
      }
    },
    {
      "parameters": {
        "jsCode": "const parsed = JSON.parse($input.first().json.message.content);\nreturn [{\n  json: {\n    ...$('Normalize Lead Data').first().json,\n    score: parsed.score,\n    reasoning: parsed.reasoning,\n    draft_reply: parsed.draft_reply,\n  }\n}];"
      },
      "id": "89e81c3a-4e6c-4c27-ac66-13b5e341c513",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [620, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.score }}",
              "rightValue": "hot",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "da1d939c-d238-4f0b-be41-fc6d515d8330",
      "name": "Is Hot Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [840, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://YOUR_KOMMO_SUBDOMAIN.kommo.com/api/v4/leads",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "kommoApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: $json.leadName, custom_fields_values: [ { field_code: \"LEAD_SCORE\", values: [ { value: $json.score } ] } ], _embedded: { tags: [ { name: \"hot-lead\" } ] } }) }}",
        "options": {}
      },
      "id": "88ce2a65-e346-488a-b230-174526fb5b98",
      "name": "Update Kommo CRM (Hot Lead)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 180]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": { "mode": "name", "value": "sales-hot-leads" },
        "text": "=🔥 *Hot lead*: {{ $json.leadName }} ({{ $json.leadEmail }})\n*Why*: {{ $json.reasoning }}\n*Suggested reply*: {{ $json.draft_reply }}",
        "otherOptions": {}
      },
      "id": "ce72eed9-5334-4844-b982-71a29d914e98",
      "name": "Notify Sales (Hot Lead)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1300, 180],
      "credentials": {
        "slackApi": { "id": "SLACK_CREDENTIAL_ID", "name": "Slack account" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://services.leadconnectorhq.com/contacts/",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "highLevelApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: $json.leadName, email: $json.leadEmail, phone: $json.leadPhone, tags: [\"nurture\", $json.score] }) }}",
        "options": {}
      },
      "id": "5421765c-fc09-4b52-b35d-a13cde90a219",
      "name": "Add to GoHighLevel Nurture Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 420]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.leadEmail }}",
        "subject": "=Thanks for reaching out, {{ $json.leadName }}!",
        "message": "={{ $json.draft_reply }}",
        "options": {}
      },
      "id": "3e68f4cc-48d5-43ef-8a36-c65922ef4ab7",
      "name": "Send Automated Nurture Reply",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1300, 420],
      "credentials": {
        "gmailOAuth2": { "id": "GMAIL_CREDENTIAL_ID", "name": "Gmail account" }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "mode": "id", "value": "YOUR_GOOGLE_SHEET_ID" },
        "sheetName": { "mode": "name", "value": "Leads" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Name": "={{ $json.leadName }}",
            "Email": "={{ $json.leadEmail }}",
            "Score": "={{ $json.score }}",
            "Source": "={{ $json.leadSource }}",
            "Timestamp": "={{ $now.toISO() }}"
          }
        },
        "options": {}
      },
      "id": "d8437997-5070-4c3c-b3e9-46cee204d30b",
      "name": "Log Lead to Tracking Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1520, 300],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "GOOGLE_SHEETS_CREDENTIAL_ID", "name": "Google Sheets account" }
      }
    }
  ],
  "connections": {
    "New Lead Webhook": { "main": [[{ "node": "Normalize Lead Data", "type": "main", "index": 0 }]] },
    "Normalize Lead Data": { "main": [[{ "node": "AI Lead Scoring & Reply Draft", "type": "main", "index": 0 }]] },
    "AI Lead Scoring & Reply Draft": { "main": [[{ "node": "Parse AI Response", "type": "main", "index": 0 }]] },
    "Parse AI Response": { "main": [[{ "node": "Is Hot Lead?", "type": "main", "index": 0 }]] },
    "Is Hot Lead?": {
      "main": [
        [{ "node": "Update Kommo CRM (Hot Lead)", "type": "main", "index": 0 }],
        [{ "node": "Add to GoHighLevel Nurture Pipeline", "type": "main", "index": 0 }]
      ]
    },
    "Update Kommo CRM (Hot Lead)": { "main": [[{ "node": "Notify Sales (Hot Lead)", "type": "main", "index": 0 }]] },
    "Notify Sales (Hot Lead)": { "main": [[{ "node": "Log Lead to Tracking Sheet", "type": "main", "index": 0 }]] },
    "Add to GoHighLevel Nurture Pipeline": { "main": [[{ "node": "Send Automated Nurture Reply", "type": "main", "index": 0 }]] },
    "Send Automated Nurture Reply": { "main": [[{ "node": "Log Lead to Tracking Sheet", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": {
    "description": "Portfolio demo workflow by Zayam Mushtaq. Requires your own OpenAI, Kommo, GoHighLevel, Slack, Gmail, and Google Sheets credentials before activating."
  }
}
